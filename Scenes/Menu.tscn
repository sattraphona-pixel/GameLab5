[node name="Text" type="Label" parent="UI/Menu/Help" unique_id=1710889971]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "HOW TO PLAY

W A S D  -  move            SPACE  -  jump (press again in the air = double jump / flip)
Q / E  or arrow keys  -  turn the camera (or hold the left mouse button and drag)

Avoid the spikes and spinning blades, don't fall off the islands.
Collect ALL the coins to unlock the exit door, then walk into it.
Touch a flag to save a checkpoint. Orange pads bounce you high!"
autowrap_mode = 3
